{
  "lastChangelogVersion": "1.4.0",
  "defaultThinkingLevel": "high",
  "theme": "dark",
  "defaultProvider": "zai",
  "defaultModel": "glm-5.3",
  "packages": [
    "npm:pi-web-access",
    "npm:@howaboua/pi-vent",
    "npm:pi-commandcode-provider",
    "npm:@tintinweb/pi-subagents"
  ],
  "hideThinkingBlock": false,
  "transport": "sse",
  "markdown": {
    "codeBlockIndent": ""
  },
  "outputPad": 0,
  "retry": {
    "enabled": true,
    "maxRetries": 12,
    "baseDelayMs": 5000,
    "provider": {
      "maxRetries": 0
    }
  },
  "tuiMode": "fullscreen",
  "extensions": [
    "-builtin:mcp"
  ]
}