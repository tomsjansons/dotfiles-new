# Sourced from .zshrc (found next to it).

# ---------------------------------------------------------------------------
# orp-cleanup: find and remove orphaned advangrid dev environments.
#
# When herdr closes a workspace/pane it can leave behind:
#   - detached tmux sessions (advangrid-<slot>) running dev servers/watchers
#   - docker compose projects (advangrid-<slot>) with ~7 containers each
#   - slot state dirs ($XDG_STATE_HOME/advangrid-dev/<slot>) and named volumes
#
# A tmux session is "orphaned" when no live herdr workspace references its
# worktree (fallback: no attached client, when herdr is unavailable). A
# compose project or state dir is orphaned when its slot has no surviving
# tmux session.
#
# Also removes herdr worktrees (~/.herdr/worktrees) that no open herdr
# workspace or pane uses, Claude Code worktrees (<repo>/.claude/worktrees)
# whose sessions have been idle for over a week, stopped podman containers/pods (k3d clusters kept),
# and every podman image no remaining container uses.
#
# Also removes leaked OpenSandbox sandboxes and egress sidecars, and restarts
# live opensandbox servers that have piled up unreaped zombie children.
#
# Usage: orp-cleanup [-n|--dry-run] [-y|--yes]
orp-cleanup() {
  local dry_run=0 assume_yes=0
  while (( $# )); do
    case "$1" in
      -n|--dry-run) dry_run=1 ;;
      -y|--yes)     assume_yes=1 ;;
      -h|--help)    print -r -- 'Usage: orp-cleanup [-n|--dry-run] [-y|--yes]'; return 0 ;;
      *)            print -u2 -- "orp-cleanup: unknown option: $1"; return 2 ;;
    esac
    shift
  done

  local state_root="${XDG_STATE_HOME:-$HOME/.local/state}/advangrid-dev"
  local -a live_worktrees orphan_sessions orphan_projects orphan_state vols nets
  local -a sorted_slots sorted_res_slots
  local -A live_slots orphan_slots orphan_res_slots
  local session project slot cwd attached d orphan rc=0

  # Live herdr workspaces (preferred liveness signal).
  if (( $+commands[herdr] && $+commands[jq] )); then
    live_worktrees=(${(f)"$(herdr workspace list 2>/dev/null \
      | jq -r '.result.workspaces[] | .worktree.checkout_path // empty' 2>/dev/null)"})
  fi

  # A slot whose recorded worktree is open in herdr is live even when its tmux
  # session is gone (e.g. after a tmux server restart).
  if (( ${#live_worktrees} )) && [[ -d "$state_root" ]]; then
    for d in "$state_root"/<->(N/); do
      cwd="$(sed -n 's/^WORKTREE_PATH=//p' "$d/env" 2>/dev/null | head -n 1)"
      [[ -n "$cwd" && " ${live_worktrees[*]} " == *" $cwd "* ]] && live_slots[${d:t}]=1
    done
  fi

  # 1. tmux sessions advangrid-<slot> orphaned by closed herdr workspaces.
  if (( $+commands[tmux] )); then
    for session in ${(f)"$(tmux list-sessions -F '#S' 2>/dev/null)"}; do
      [[ "$session" == advangrid-<-> ]] || continue
      slot="${session#advangrid-}"
      orphan=0
      if (( ${#live_worktrees} )); then
        cwd="$(tmux list-panes -t "$session" -F '#{pane_current_path}' 2>/dev/null | head -n 1)"
        if [[ -z "$cwd" || " ${live_worktrees[*]} " != *" $cwd "* ]]; then
          orphan=1
        fi
      else
        attached="$(tmux display-message -p -t "$session" '#{session_attached}' 2>/dev/null)"
        [[ "$attached" == "0" ]] && orphan=1
      fi
      if (( orphan )); then
        orphan_sessions+=("$session")
        orphan_slots[$slot]=1
      else
        live_slots[$slot]=1
      fi
    done
  fi

  # 2. docker compose projects advangrid-<slot> with no surviving tmux session.
  if (( $+commands[docker] )); then
    for project in ${(f)"$(docker ps -a \
        --filter label=com.docker.compose.project \
        --format '{{.Label "com.docker.compose.project"}}' 2>/dev/null | sort -u)"}; do
      [[ "$project" == advangrid-<-> ]] || continue
      slot="${project#advangrid-}"
      (( ${live_slots[$slot]:-0} )) && continue
      orphan_projects+=("$project")
      orphan_slots[$slot]=1
    done
  fi

  # 2b. leftover volumes/networks carrying an advangrid-<slot> project label
  # (containers and state dirs may already be gone).
  if (( $+commands[docker] )); then
    for project in ${(f)"$( {
        docker volume ls --filter label=com.docker.compose.project --format '{{.Label "com.docker.compose.project"}}'
        docker network ls --filter label=com.docker.compose.project --format '{{.Label "com.docker.compose.project"}}'
      } 2>/dev/null | sort -u)"}; do
      [[ "$project" == advangrid-<-> ]] || continue
      slot="${project#advangrid-}"
      (( ${live_slots[$slot]:-0} )) && continue
      orphan_res_slots[$slot]=1
      orphan_slots[$slot]=1
    done
  fi

  # 3. leftover slot state dirs whose containers are long gone.
  if [[ -d "$state_root" ]]; then
    for d in "$state_root"/<->(N/); do
      slot="${d:t}"
      (( ${live_slots[$slot]:-0} )) && continue
      orphan_state+=("$d")
      orphan_slots[$slot]=1
    done
  fi

  # 4. herdr worktrees (~/.herdr/worktrees/<repo>/<name>) that no open herdr
  # workspace or pane points into. Skipped entirely unless herdr answers, so a
  # dead server never reads as "nothing is open".
  local herdr_root="$HOME/.herdr/worktrees" herdr_json wt p live common
  local -a herdr_paths orphan_worktrees dirty_worktrees
  if [[ -d "$herdr_root" ]] && (( $+commands[herdr] && $+commands[jq] )); then
    herdr_json="$( { herdr workspace list; herdr pane list; } 2>/dev/null)"
    if [[ "$herdr_json" == *workspace_list* && "$herdr_json" == *panes* ]]; then
      herdr_paths=(${(f)"$(print -r -- "$herdr_json" | jq -r '
          (.result.workspaces[]? | .worktree.checkout_path // empty),
          (.result.panes[]? | .cwd // empty, .foreground_cwd // empty)' 2>/dev/null \
        | sed 's/ (deleted)$//')"})
      for wt in "$herdr_root"/*/*(N/); do
        live=0
        for p in "${herdr_paths[@]}"; do
          [[ "$p" == "$wt" || "$p" == "$wt"/* ]] && { live=1; break }
        done
        (( live )) && continue
        orphan_worktrees+=("$wt")
        [[ -n "$(git -C "$wt" status --porcelain 2>/dev/null | head -n 1)" ]] && dirty_worktrees+=("${wt#$herdr_root/}")
      done
    else
      print -u2 -- "orp-cleanup: herdr not responding; skipping worktree cleanup."
    fi
  fi

  # 4b. Claude Code worktrees (<repo>/.claude/worktrees/<name>) whose sessions
  # have been idle for over a week. Activity is the newest transcript mtime:
  # for agent-<id> worktrees the subagent transcript plus its parent session,
  # otherwise the sessions recorded for the worktree path itself. Without any
  # transcript, the worktree's git index mtime stands in. Kept regardless when
  # a herdr pane or a running process is inside it.
  local claude_projects="$HOME/.claude/projects" newest idle_cutoff
  local -a claude_worktrees proc_cwds activity
  zmodload -F zsh/datetime p:EPOCHSECONDS 2>/dev/null
  idle_cutoff=$(( EPOCHSECONDS - 7 * 86400 ))
  proc_cwds=(${(f)"$(for p in /proc/<->/cwd(N); do print -r -- "${p:A}"; done 2>/dev/null)"})
  for wt in "$HOME"/dev/*/.claude/worktrees/*(N/) "$herdr_root"/*/*/.claude/worktrees/*(N/); do
    live=0
    for p in "${herdr_paths[@]}" "${proc_cwds[@]}"; do
      [[ "$p" == "$wt" || "$p" == "$wt"/* ]] && { live=1; break }
    done
    (( live )) && continue
    activity=()
    if [[ "${wt:t}" == agent-* ]]; then
      for p in "$claude_projects"/*/*/subagents/"${wt:t}".jsonl(N); do
        activity+=("$p" "${p:h:h}.jsonl"(N))
      done
    fi
    activity+=("$claude_projects/${wt//[^A-Za-z0-9]/-}"/*.jsonl(N))
    if (( ! ${#activity} )); then
      p="$(git -C "$wt" rev-parse --path-format=absolute --git-path index 2>/dev/null)"
      [[ -e "$p" ]] && activity=("$p")
    fi
    newest="$(stat -c %Y -- "${activity[@]}" 2>/dev/null | sort -n | tail -n 1)"
    (( ${newest:-0} < idle_cutoff )) || continue
    claude_worktrees+=("$wt")
    [[ -n "$(git -C "$wt" status --porcelain 2>/dev/null | head -n 1)" ]] && dirty_worktrees+=("${wt/#$HOME/~}")
  done

  # 5. old podman state: stopped containers (except k3d clusters, which
  # 'k3d cluster start' needs), exited pods, and every image no container uses.
  # Compose links containers to their depends_on targets, and podman refuses to
  # remove a dependency while a dependent exists. Stopped containers a running
  # one (transitively) depends on, like a live stack's init/migrate jobs, are
  # kept; the rest are removed in dependency order below.
  local -a old_containers old_pods frontier next pending failed
  local -A required
  local id images_reclaim=""
  if (( $+commands[docker] )); then
    frontier=(${(f)"$(docker ps -q --no-trunc 2>/dev/null)"})
    while (( ${#frontier} )); do
      next=(${=${(f)"$(docker inspect --format '{{range .Dependencies}}{{.}} {{end}}' \
        "${frontier[@]}" 2>/dev/null)"}})
      frontier=()
      for id in "${next[@]}"; do
        (( ${+required[$id]} )) || { required[$id]=1; frontier+=("$id") }
      done
    done
    for id in ${(f)"$(docker ps -a --no-trunc --filter status=exited --filter status=created \
        --format '{{.ID}} {{.Label "app"}}' 2>/dev/null | awk '$2 != "k3d" { print $1 }')"}; do
      (( ${+required[$id]} )) || old_containers+=("$id")
    done
    old_pods=(${(f)"$(docker pod ls -q --filter status=exited 2>/dev/null)"})
    images_reclaim="$(docker system df --format '{{.Type}} {{.Reclaimable}}' 2>/dev/null \
      | sed -n 's/^Images //p')"
    [[ "$images_reclaim" == 0B* ]] && images_reclaim=""
  fi

  # 6. OpenSandbox sandboxes (+ their egress sidecars) left running by the dev
  # stacks' opensandbox servers. Every slot's server talks to the same podman
  # socket and sandboxes carry no slot label, so ownership can't be traced; a
  # sandbox is orphaned when it has expired, when no live slot runs an
  # opensandbox server, or when it is older than $ORP_SANDBOX_MAX_AGE_HOURS
  # (default 12). Each running container pins a kernel session keyring, and the
  # per-user keyring quota (200) is what breaks keyctl/sec-login when they leak.
  local -a orphan_sandboxes orphan_egress live_sb_ids
  local now_iso sb_id expires created sb_cutoff server_live=0
  if (( $+commands[docker] )); then
    for project in ${(f)"$(docker ps --filter label=com.docker.compose.service=opensandbox \
        --format '{{.Label "com.docker.compose.project"}}' 2>/dev/null)"}; do
      [[ "$project" == advangrid-<-> ]] || continue
      (( ${live_slots[${project#advangrid-}]:-0} )) && { server_live=1; break }
    done
    now_iso="$(date -u +%Y-%m-%dT%H:%M:%S)"
    sb_cutoff=$(( EPOCHSECONDS - ${ORP_SANDBOX_MAX_AGE_HOURS:-12} * 3600 ))
    for id sb_id expires created in ${=${(f)"$(docker ps -q --no-trunc --filter label=opensandbox.io/id 2>/dev/null \
        | xargs -r docker inspect --format '{{.Id}} {{index .Config.Labels "opensandbox.io/id"}} {{index .Config.Labels "opensandbox.io/expires-at"}} {{.Created.Unix}}' 2>/dev/null)"}}; do
      if (( ! server_live || created < sb_cutoff )) || [[ "$expires" < "$now_iso" ]]; then
        orphan_sandboxes+=("$id")
      else
        live_sb_ids+=("$sb_id")
      fi
    done
    # Sidecars whose sandbox is being removed or already gone.
    for id sb_id in ${=${(f)"$(docker ps -a --no-trunc --filter label=opensandbox.io/egress-sidecar-for \
        --format '{{.ID}} {{.Label "opensandbox.io/egress-sidecar-for"}}' 2>/dev/null)"}}; do
      (( ${live_sb_ids[(Ie)$sb_id]} )) || orphan_egress+=("$id")
    done
  fi

  # 7. Zombie children piling up under live opensandbox servers. The server runs
  # as PID 1 in its container without an init, so the subprocesses it spawns
  # are never reaped. Restarting the container clears them (orphaned slots are
  # torn down above anyway). Threshold: $ORP_ZOMBIE_MIN (default 20).
  local -a zombie_servers zombie_counts
  local pid nz
  if (( $+commands[docker] )); then
    for id project pid in ${=${(f)"$(docker ps -q --filter label=com.docker.compose.service=opensandbox 2>/dev/null \
        | xargs -r docker inspect --format '{{.Name}} {{index .Config.Labels "com.docker.compose.project"}} {{.State.Pid}}' 2>/dev/null)"}}; do
      [[ "$project" == advangrid-<-> ]] && (( ${live_slots[${project#advangrid-}]:-0} )) || continue
      nz="$(ps --ppid "$pid" -o stat= 2>/dev/null | grep -c '^Z')"
      (( nz >= ${ORP_ZOMBIE_MIN:-20} )) || continue
      zombie_servers+=("$id")
      zombie_counts+=("$id ($nz)")
    done
  fi

  if (( ! ${#orphan_sessions} && ! ${#orphan_projects} && ! ${#orphan_state} && ! ${#orphan_res_slots} \
        && ! ${#orphan_worktrees} && ! ${#claude_worktrees} && ! ${#old_containers} && ! ${#old_pods} \
        && ! ${#orphan_sandboxes} && ! ${#orphan_egress} && ! ${#zombie_servers} )) && [[ -z "$images_reclaim" ]]; then
    print -r -- "orp-cleanup: nothing to clean up."
    return 0
  fi

  print -r -- "Orphaned advangrid dev environments:"
  (( ${#orphan_sessions} )) && print -r -- "  tmux sessions:   ${(j: :)orphan_sessions}"
  (( ${#orphan_projects} )) && print -r -- "  docker projects: ${(j: :)orphan_projects}"
  (( ${#orphan_state} ))    && print -r -- "  state dirs:      ${(j: :)orphan_state}"
  # (zsh key-sort flags are unreliable here; sort slot numbers explicitly)
  (( ${#orphan_slots} ))     && sorted_slots=(${(f)"$(print -l -- ${(k)orphan_slots} | sort -n)"})
  (( ${#orphan_res_slots} )) && sorted_res_slots=(${(f)"$(print -l -- ${(k)orphan_res_slots} | sort -n)"})
  (( ${#sorted_res_slots} )) && print -r -- "  vols/nets only:  slots ${(j: :)sorted_res_slots}"
  (( ${#sorted_slots} ))     && print -r -- "  slots:           ${(j: :)sorted_slots}"
  if (( ${#orphan_worktrees} )); then
    print -r -- "  herdr worktrees: ${#orphan_worktrees} not open in herdr"
    local -a wt_names=("${(@)orphan_worktrees#$herdr_root/}")
    print -rl -- "${(@)wt_names/#/    }"
  fi
  if (( ${#claude_worktrees} )); then
    print -r -- "  claude worktrees: ${#claude_worktrees} idle for over a week"
    local -a cwt_names=("${(@)claude_worktrees/#$HOME/~}")
    print -rl -- "${(@)cwt_names/#/    }"
  fi
  (( ${#dirty_worktrees} )) && print -r -- "  worktrees with uncommitted changes (lost on removal): ${(j: :)dirty_worktrees}"
  (( ${#old_containers} )) && print -r -- "  podman:          ${#old_containers} stopped containers (k3d and live-stack deps kept)"
  (( ${#old_pods} ))       && print -r -- "  podman:          ${#old_pods} exited pods"
  [[ -n "$images_reclaim" ]] && print -r -- "  podman:          unused images, ~$images_reclaim reclaimable"
  (( ${#orphan_sandboxes} || ${#orphan_egress} )) \
    && print -r -- "  sandboxes:       ${#orphan_sandboxes} opensandbox sandboxes + ${#orphan_egress} egress sidecars (expired, >${ORP_SANDBOX_MAX_AGE_HOURS:-12}h old, or no live server)"
  (( ${#zombie_servers} )) && print -r -- "  zombies:         restart ${(j:, :)zombie_counts}"

  if (( dry_run )); then
    print -r -- "Dry run; nothing removed."
    return 0
  fi

  if (( ! assume_yes )); then
    read -q "reply?Remove all of the above? [y/N] " || { print; return 1; }
    print
  fi

  for session in "${orphan_sessions[@]}"; do
    print -r -- "killing tmux session $session"
    tmux kill-session -t "$session" || rc=1
  done

  # Removed by label rather than 'compose down': without the project's compose
  # file, podman-compose removes containers in arbitrary order and podman
  # refuses each one that a depends_on link still points at. --depend takes
  # the dependents along; the pod podman-compose created goes last.
  local -a proj_ctrs
  for project in "${orphan_projects[@]}"; do
    print -r -- "tearing down docker project $project"
    proj_ctrs=(${(f)"$(docker ps -aq --filter "label=com.docker.compose.project=$project" 2>/dev/null)"})
    (( ${#proj_ctrs} )) && { docker rm -f --depend -t 5 "${proj_ctrs[@]}" >/dev/null || rc=1 }
    docker pod exists "pod_$project" 2>/dev/null && { docker pod rm -f "pod_$project" >/dev/null || rc=1 }
  done

  # Named volumes/networks carry the same project label.
  if (( $+commands[docker] )); then
    for slot in "${sorted_slots[@]}"; do
      vols=(${(f)"$(docker volume ls -q --filter "label=com.docker.compose.project=advangrid-$slot" 2>/dev/null)"})
      if (( ${#vols} )); then
        print -r -- "removing volumes: ${(j: :)vols}"
        docker volume rm "${vols[@]}" || rc=1
      fi
      nets=(${(f)"$(docker network ls -q --filter "label=com.docker.compose.project=advangrid-$slot" 2>/dev/null)"})
      if (( ${#nets} )); then
        print -r -- "removing network:  advangrid-$slot default"
        docker network rm "${nets[@]}" >/dev/null || rc=1
      fi
    done
  fi

  for d in "${orphan_state[@]}"; do
    print -r -- "removing state dir $d"
    rm -rf -- "$d" || rc=1
  done

  # Let git drop its worktree record; plain rm for dirs git no longer knows.
  local -A wt_repos
  for wt in "${orphan_worktrees[@]}" "${claude_worktrees[@]}"; do
    print -r -- "removing worktree ${wt/#$HOME/~}"
    common="$(git -C "$wt" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"
    if [[ -n "$common" ]]; then
      wt_repos[$common]=1
      git --git-dir="$common" worktree remove --force --force "$wt" 2>/dev/null && continue
    fi
    rm -rf -- "$wt" || rc=1
  done
  for common in ${(k)wt_repos}; do
    git --git-dir="$common" worktree prune || rc=1
  done
  rmdir -- "$herdr_root"/*(N/^F) 2>/dev/null

  # Sandboxes share their sidecar's network namespace, so they go first.
  if (( ${#orphan_sandboxes} )); then
    print -r -- "removing ${#orphan_sandboxes} opensandbox sandboxes"
    docker rm -f -t 2 "${orphan_sandboxes[@]}" >/dev/null || rc=1
  fi
  if (( ${#orphan_egress} )); then
    print -r -- "removing ${#orphan_egress} egress sidecars"
    docker rm -f -t 2 "${orphan_egress[@]}" >/dev/null || rc=1
  fi
  for id in "${zombie_servers[@]}"; do
    print -r -- "restarting $id to reap its zombies"
    docker restart -t 5 "$id" >/dev/null || rc=1
  done

  # Runs after the slot teardowns above so their images become unused too.
  if (( ${#old_containers} )); then
    print -r -- "removing ${#old_containers} stopped containers"
    # Retry in passes: each pass frees the dependencies of what it removed.
    pending=("${old_containers[@]}")
    while (( ${#pending} )); do
      failed=()
      for id in "${pending[@]}"; do
        docker rm "$id" >/dev/null 2>&1 || failed+=("$id")
      done
      (( ${#failed} < ${#pending} )) || break
      pending=("${failed[@]}")
    done
    if (( ${#failed} )); then
      print -u2 -- "orp-cleanup: could not remove ${#failed} stopped containers (see podman ps -a)"
      rc=1
    fi
  fi
  if (( ${#old_pods} )); then
    print -r -- "removing ${#old_pods} exited pods"
    docker pod rm -f "${old_pods[@]}" >/dev/null || rc=1
  fi
  if (( $+commands[docker] )); then
    print -r -- "pruning unused images"
    docker image prune -a -f >/dev/null || rc=1
  fi

  return $rc
}
