# shell secrets bootstrap -- sourced from .zshrc, which finds this file next
# to itself (symlinks resolved), so any deployment layout works: stow to ~,
# ZDOTDIR elsewhere, or a plain copy.
#
#   .zsh-secrets       this file -- activation & shell hooks
#   .zsh-secrets.zsh   implementation (pass-cli + kernel keyring cache);
#                      see its header for the full design
#   .zsh-secrets.map   pass-cli inject template (env var -> vault refs)
#
# Both inits are silent and fast: steady state is one wrapped keyring dump
# (~15ms) plus an `ssh-add -l` probe (~5ms) per shell. User-facing helpers
# live in .zsh-secrets.zsh: sec-api, sec-ssh, sec-login, sec-status.

_secrets_dir="${${(%):-%N}:A:h}"
[[ -r "$_secrets_dir/.zsh-secrets.zsh" ]] && source "$_secrets_dir/.zsh-secrets.zsh"

# Fresh keys for every new shell, including tabs under long-lived parents.
sec-api-init
sec-ssh-init
